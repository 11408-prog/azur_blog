azur_blog/css/sidebar.css?v=1.5\">","<link rel=\"stylesheet\" href=\"/azur_blog/css/reading-mode.css?v=1.2\">","<link rel=\"stylesheet\" href=\"/azur_blog/css/welcome_animation.css?v=1.4\">","<link rel=\"stylesheet\" href=\"/azur_blog/css/custom.css?v=1.2\">","<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.css\">","<link rel=\"stylesheet\" href=\"/azur_blog/css/music-page.css?v=1.4\">","<link rel=\"stylesheet\" href=\"/azur_blog/css/gallery.css?v=1.4\">"],"bottom":["<script src=\"/azur_blog/js/logger.js?v=1.2\"></script>","<script src=\"/azur_blog/js/blog-config.js?v=1.0\"></script>","<script src=\"/azur_blog/js/lifecycle.js?v=1.0\"></script>","<script src=\"/azur_blog/js/toc-check.js?v=1.3\"></script>","<script src=\"/azur_blog/js/gallery.js?v=1.3\"></script>","<script src=\"/azur_blog/js/welcome_animation.js?v=1.3\"></script>","<script src=\"/azur_blog/js/weather.js?v=1.2\"></script>","<script src=\"/azur_blog/js/carousel.js?v=1.3\"></script>","<script src=\"/azur_blog/js/activity.js?v=1.4\"></script>","<script src=\"/azur_blog/js/random_posts.js?v=1.2\"></script>","<script src=\"https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.js\"></script>","<script>window.meting_api=\"https://api.injahow.cn/meting/?server=:server&type=:type&id=:id&auth=:auth&r=:r\";</script>","<script src=\"https://cdn.jsdelivr.net/npm/meting@2/dist/Meting.min.js\"></script>","<script src=\"/azur_blog/js/video-cover.js?v=1.3\"></script>","<script src=\"/azur_blog/js/music.js?v=1.1\"></script>","<style>\n  /* 隐藏原悬浮工具栏 */\n  #rightside {\n    display: none !important;\n  }\n\n  /* 齿轮按钮样式（放在导航栏右侧） */\n  #nav-settings-toggle {\n    position: relative;\n    display: inline-block;\n    cursor: pointer;\n    margin-left: 15px;\n    font-size: 18px;\n    color: var(--font-color, #fff);\n    transition: 0.3s;\n    padding: 4px 8px;\n  }\n  #nav-settings-toggle:hover {\n    transform: rotate(60deg);\n    color: var(--theme-color, #49b1f5);\n  }\n\n  /* 下拉菜单容器 */\n  #nav-settings-dropdown {\n    display: none;\n    position: absolute;\n    top: 36px;\n    right: 0;\n    background: var(--card-bg, #fff);\n    border-radius: 10px;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.15);\n    min-width: 150px;\n    padding: 8px 0;\n    z-index: 99999;\n    backdrop-filter: blur(10px);\n    border: 1px solid var(--border-color, rgba(0,0,0,0.08));\n  }\n  #nav-settings-dropdown.show {\n    display: block;\n  }\n\n  /* 下拉菜单项 */\n  .nav-settings-item {\n    display: flex;\n    align-items: center;\n    padding: 10px 20px;\n    color: var(--font-color, #333);\n    font-size: 14px;\n    cursor: pointer;\n    transition: 0.2s;\n    gap: 10px;\n    white-space: nowrap;\n    border: none;\n    background: transparent;\n    width: 100%;\n    text-align: left;\n    font-family: inherit;\n  }\n  .nav-settings-item:hover {\n    background: var(--theme-color, #49b1f5);\n    color: #fff;\n  }\n  .nav-settings-item i {\n    width: 20px;\n    text-align: center;\n  }\n  .nav-settings-item .badge {\n    margin-left: auto;\n    font-size: 12px;\n    opacity: 0.6;\n  }\n\n  /* 导航栏菜单项容器（确保齿轮在正确位置） */\n  .menus {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n  }\n  #nav-settings-wrapper {\n    display: inline-flex;\n    align-items: center;\n    margin-left: 10px;\n    position: relative;\n  }\n\n  /* 移动端适配 */\n  @media screen and (max-width: 768px) {\n    #nav-settings-toggle {\n      margin-left: 8px;\n      font-size: 16px;\n    }\n    #nav-settings-dropdown {\n      right: -10px;\n      min-width: 130px;\n    }\n    .nav-settings-item {\n      padding: 8px 16px;\n      font-size: 13px;\n    }\n  }\n</style>\n<script>\n  (function() {\n    'use strict';\n\n    // ---------- 挂载齿轮到导航栏（首次 + PJAX 完成后重建） ----------\n    function mountGear() {\n      var menus = document.getElementById('menus');\n      if (!menus) return;\n\n      // 清理可能残留的旧实例\n      var old = document.getElementById('nav-settings-wrapper');\n      if (old) old.remove();\n\n      // 动态创建齿轮按钮 + 下拉菜单\n      var wrap = document.createElement('div');\n      wrap.id = 'nav-settings-wrapper';\n      wrap.innerHTML =\n        '<div id=\"nav-settings-toggle\" title=\"设置\"><i class=\"fas fa-cog\"></i></div>' +\n        '<div id=\"nav-settings-dropdown\">' +\n          '<button class=\"nav-settings-item\" id=\"nav-darkmode-toggle\"><i class=\"fas fa-moon\"></i><span>暗色模式</span><span class=\"badge\" id=\"nav-darkmode-status\">关</span></button>' +\n          '<button class=\"nav-settings-item\" id=\"nav-bgm-toggle\"><i class=\"fas fa-music\"></i><span>背景音乐</span><span class=\"badge\" id=\"nav-bgm-status\">▶</span></button>' +\n        '</div>';\n      menus.appendChild(wrap);\n\n      var toggleBtn = document.getElementById('nav-settings-toggle');\n      var dropdown = document.getElementById('nav-settings-dropdown');\n      var darkBtn = document.getElementById('nav-darkmode-toggle');\n      var darkStatus = document.getElementById('nav-darkmode-status');\n      var bgmBtn = document.getElementById('nav-bgm-toggle');\n      var bgmStatus = document.getElementById('nav-bgm-status');\n\n      function getCurrentMode() {\n        // Butterfly 主题用 html 的 data-theme 属性标记暗色模式\n        return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';\n      }\n\n      function updateDarkUI() {\n        var isDark = getCurrentMode() === 'dark';\n        darkStatus.textContent = isDark ? '开' : '关';\n        darkBtn.querySelector('i').className = isDark ? 'fas fa-sun' : 'fas fa-moon';\n      }\n\n      function updateBgmUI() {\n        var ap = window._aplayer_instance;\n        if (!ap || !ap.audio) { bgmStatus.textContent = '⏹'; return; }\n        var playing = !ap.audio.paused;\n        bgmStatus.textContent = playing ? '⏸' : '▶';\n        bgmBtn.querySelector('i').style.color = playing ? '#ff6b6b' : '';\n      }\n\n      // 下拉显隐\n      toggleBtn.addEventListener('click', function(e) {\n        e.stopPropagation();\n        dropdown.classList.toggle('show');\n      });\n      document.addEventListener('click', function() {\n        dropdown.classList.remove('show');\n      });\n      dropdown.addEventListener('click', function(e) {\n        e.stopPropagation();\n      });\n\n      // 暗色切换（触发主题原生逻辑，与 data-theme 同步）\n      darkBtn.addEventListener('click', function() {\n        var nativeBtn = document.querySelector('#rightside .darkmode-button');\n        if (nativeBtn) {\n          nativeBtn.click();\n        } else {\n          var html = document.documentElement;\n          var isDark = html.getAttribute('data-theme') === 'dark';\n          html.setAttribute('data-theme', isDark ? 'light' : 'dark');\n          localStorage.setItem('theme', isDark ? 'light' : 'dark');\n        }\n        setTimeout(updateDarkUI, 100);\n      });\n\n      // BGM 控制（APlayer 1.x 的 play/pause 不返回 Promise，直接调用）\n      bgmBtn.addEventListener('click', function() {\n        var ap = window._aplayer_instance;\n        if (!ap || !ap.audio) {\n          DSLog.warn('Settings', 'BGM 播放器未初始化');\n          return;\n        }\n        if (!ap.audio.paused) {\n          ap.pause();\n        } else {\n          ap.play();\n        }\n        setTimeout(updateBgmUI, 200);\n      });\n\n      updateDarkUI();\n      setTimeout(updateBgmUI, 300);\n    }\n\n    // ---------- 全局监听（只注册一次，元素每次挂载后动态查询） ----------\n    new MutationObserver(function() {\n      var s = document.getElementById('nav-darkmode-status');\n      var i = document.querySelector('#nav-darkmode-toggle i');\n      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';\n      if (s) s.textContent = isDark ? '开' : '关';\n      if (i) i.className = isDark ? 'fas fa-sun' : 'fas fa-moon';\n    }).observe(document.documentElement, {\n      attributes: true,\n      attributeFilter: ['data-theme']\n    });\n\n    document.addEventListener('bgmStateChange', function() {\n      var s = document.getElementById('nav-bgm-status');\n      var ap = window._aplayer_instance;\n      if (!s) return;\n      if (!ap || !ap.audio) { s.textContent = '⏹'; return; }\n      s.textContent = !ap.audio.paused ? '⏸' : '▶';\n    });\n\n    // ---------- 首次挂载 + PJAX 完成后重建（PJAX 会替换 #body-wrap，齿轮随 #menus 丢失） ----------\n    mountGear();\n    document.addEventListener('pjax:complete', mountGear);\n\n    console.log('[设置] 导航栏齿轮菜单已初始化');\n    if (window.DSLog) DSLog.info('Settings', '导航栏齿轮菜单已初始化');\n  })();\n</script>\n"]},"CDN":{"internal_provider":"local","third_party_provider":"jsdelivr","version":true,"custom_format":null,"option":{"katex":"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css","katex_copytex":"https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/copy-tex.min.js"}},"aplayerInject":{"enable":true,"per_page":true}}