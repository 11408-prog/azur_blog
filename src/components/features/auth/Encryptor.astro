---
import "@/styles/encrypted-content.css";

import { encryptContent } from "@utils/crypto-utils";

import PasswordProtection from "./PasswordProtection.astro";

export interface Props {
	password: string | number;
	/** 已弃用：加密不再依赖 slug，保留该属性只是为了兼容已有调用 */
	slug?: string;
	hint?: string;
}

const { password, hint = "" } = Astro.props;

const htmlContent = await Astro.slots.render("default");

const encryptedContent = encryptContent(htmlContent, String(password));
---

<PasswordProtection encryptedContent={encryptedContent} hint={hint} />
