{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:web && hexo generate",
    "build:web": "node web/build.mjs",
    "dev:web": "node web/build.mjs --watch",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "npm run build:web && hexo server",
    "test": "node test/validate-build.js",
    "test:build": "npm run clean && npm run build && npm test",
    "test:quick": "node test/validate-build.js --quick"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "@renbaoshuo/markdown-it-katex": "^2.0.2",
    "hexo": "^8.0.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-filter-mathjax": "^0.11.1",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-markdown-it": "^7.1.1",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-tag-aplayer": "^3.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.3"
  }
}
